# RemoteReady Environment Variables

# Neon PostgreSQL Database URL
# Example: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-cool-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Base URL (Optional for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
